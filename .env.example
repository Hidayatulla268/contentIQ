# ==========================================
# ContentIQ - Environment Variables
# ==========================================

# Hindsight Persistent Memory Configuration
# Supports Hindsight Cloud (https://api.hindsight.vectorize.io or similar) or Self-Hosted
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=contentiq::acme-tech

# LLM Provider (Groq is default for HackwithHyderabad)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Primary Database (PostgreSQL - SQLite fallback supported for rapid local testing)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/contentiq
# SQLite fallback: sqlite+aiosqlite:///./contentiq.db

# Redis Caching (Optional, in-memory cache fallback supported)
REDIS_URL=redis://localhost:6379/0

# External Trend Integrations (Optional)
NEWS_API_KEY=
YOUTUBE_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
